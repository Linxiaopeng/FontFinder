var onRun = function (context) {
    var sketch = require('sketch');
    var document = sketch.getSelectedDocument();
    if (!document) {
        sketch.UI.message("未找到打开的 Sketch 文档。");
        return;
    }
    
    var page = document.selectedPage;
    if (!page) {
        sketch.UI.message("当前没有活动的页面。");
        return;
    }

    var includedFontNames = [];
    var fontCheck = {};
    var layerToFontsMap = [];

    // 安全地从 Text 图层获取所有字体名称
    function getFontNamesForLayer(layer) {
        var fonts = [];
        
        // 方案 1: 优先使用 Sketch JS API 官方提供的、最稳定的原生属性
        if (layer.style && layer.style.fontFamily) {
            var jsFont = String(layer.style.fontFamily);
            if (jsFont && jsFont !== "undefined") {
                fonts.push(jsFont);
            }
        }

        // 方案 2: 降级到底层的原生对象读取（作为多字体混用时的补充）
        var nativeLayer = layer.sketchObject;
        if (nativeLayer) {
            // 尝试读取单一字体的原生属性
            try {
                if (typeof nativeLayer.font === 'function') {
                    var nsFont = nativeLayer.font();
                    if (nsFont) {
                        var fontName = String(nsFont.fontName());
                        if (fontName && fontName !== "null" && fonts.indexOf(fontName) === -1) {
                            fonts.push(fontName);
                        }
                    }
                }
            } catch (e) {}

            // 针对多字体混用，通过原生 NSAttributedString 属性遍历
            try {
                if (typeof nativeLayer.attributedString === 'function') {
                    var attrStr = nativeLayer.attributedString();
                    if (attrStr) {
                        // 遍历富文本属性块
                        var length = attrStr.length();
                        var effectiveRange = MOPointer.alloc().initWithValue(NSMakeRange(0, 0));
                        var idx = 0;
                        while (idx < length) {
                            var attrs = attrStr.attributesAtIndex_effectiveRange(idx, effectiveRange);
                            // NSFontAttributeName 通常在桥接中表现为 "NSFont"
                            var fontAttr = attrs.objectForKey("NSFont") || attrs.objectForKey("NSFontAttributeName");
                            if (fontAttr) {
                                var fName = String(fontAttr.fontName());
                                if (fName && fonts.indexOf(fName) === -1) {
                                    fonts.push(fName);
                                }
                            }
                            idx = effectiveRange.value().location + effectiveRange.value().length;
                        }
                    }
                }
            } catch (e) {}
        }

        return fonts;
    }

    // 查找当前 Page 下的所有 Text 图层（使用最新的标准选择器）
    var textLayers = sketch.find('Text', page);
    
    for (var i = 0; i < textLayers.length; i++) {
        var layer = textLayers[i];
        var fonts = getFontNamesForLayer(layer);
        if (fonts.length > 0) {
            layerToFontsMap.push({
                layer: layer,
                fonts: fonts
            });
            for (var j = 0; j < fonts.length; j++) {
                var fName = fonts[j];
                if (!fontCheck[fName]) {
                    fontCheck[fName] = true;
                    includedFontNames.push(fName);
                }
            }
        }
    }

    includedFontNames.sort();

    // 创建 macOS 原生 NSAlert 弹窗
    var alert = NSAlert.alloc().init();
    alert.setMessageText('Font Finder (字体查找工具)');
    
    if (includedFontNames.length === 0) {
        alert.setInformativeText("当前页面未包含任何文本字体。");
        alert.addButtonWithTitle('确定');
        alert.runModal();
        return;
    }

    alert.setInformativeText('请勾选你想要查找并选中的字体：');
    alert.addButtonWithTitle('选择并定位');
    alert.addButtonWithTitle('取消');

    var rowHeight = 24;
    var containerWidth = 350;
    var containerHeight = includedFontNames.length * rowHeight;
    var maxContainerHeight = 240;
    
    var containerView = NSView.alloc().initWithFrame(NSMakeRect(0, 0, containerWidth, containerHeight));
    
    var checkboxes = [];
    for (var i = 0; i < includedFontNames.length; i++) {
        var y = (includedFontNames.length - 1 - i) * rowHeight;
        var checkbox = NSButton.alloc().initWithFrame(NSMakeRect(0, y, containerWidth - 20, 20));
        checkbox.setButtonType(3); // 3 代表 NSSwitchButton
        checkbox.setTitle(includedFontNames[i]);
        checkbox.setState(0);
        containerView.addSubview(checkbox);
        checkboxes.push(checkbox);
    }

    if (containerHeight > maxContainerHeight) {
        var scrollView = NSScrollView.alloc().initWithFrame(NSMakeRect(0, 0, containerWidth, maxContainerHeight));
        scrollView.setHasVerticalScroller(true);
        scrollView.setHasHorizontalScroller(false);
        scrollView.setDocumentView(containerView);
        containerView.scrollPoint(NSMakePoint(0, containerHeight - maxContainerHeight));
        alert.setAccessoryView(scrollView);
    } else {
        alert.setAccessoryView(containerView);
    }

    var response = alert.runModal();
    if (response == 1000) { 
        var selectingFonts = [];
        for (var i = 0; i < checkboxes.length; i++) {
            if (checkboxes[i].state() == 1) { 
                selectingFonts.push(checkboxes[i].title());
            }
        }

        if (selectingFonts.length > 0) {
            // 修正：正确的清除选择集图层的方法
            document.selectedLayers.layers = [];
            
            var selectedCount = 0;
            for (var i = 0; i < layerToFontsMap.length; i++) {
                var item = layerToFontsMap[i];
                var matched = false;
                for (var j = 0; j < item.fonts.length; j++) {
                    if (selectingFonts.indexOf(item.fonts[j]) !== -1) {
                        matched = true;
                        break;
                    }
                }
                if (matched) {
                    item.layer.selected = true;
                    selectedCount++;
                }
            }

            sketch.UI.message("已成功选中 " + selectedCount + " 个匹配字体的文本图层。");
        } else {
            sketch.UI.message("未勾选任何字体。");
        }
    }
};