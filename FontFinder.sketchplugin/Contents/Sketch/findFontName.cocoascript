var onRun = function (context) {
    var sketch = require('sketch');
    var UI = sketch.UI;

    var document = sketch.getSelectedDocument();

    if (!document) {
        UI.message("未找到打开的文档");
        return;
    }

    var page = document.selectedPage;

    if (!page) {
        UI.message("未找到当前页面");
        return;
    }

    //--------------------------------------------------
    // 获取文本图层中的字体
    //--------------------------------------------------
    function getFontsFromTextLayer(layer) {

        var fonts = [];

        try {

            var nativeLayer = layer.sketchObject;

            if (!nativeLayer) {
                return fonts;
            }

            // 单字体
            try {

                if (typeof nativeLayer.font === "function") {

                    var font = nativeLayer.font();

                    if (font) {

                        var fontName = String(font.fontName());

                        if (
                            fontName &&
                            fonts.indexOf(fontName) === -1
                        ) {
                            fonts.push(fontName);
                        }
                    }
                }

            } catch (err) {
                log("Single Font Error: " + err);
            }

            // 混合字体
            try {

                if (
                    typeof nativeLayer.attributedString === "function"
                ) {

                    var attrString =
                        nativeLayer.attributedString();

                    if (attrString) {

                        var length = attrString.length();

                        var rangePointer =
                            MOPointer.alloc().init();

                        var index = 0;

                        while (index < length) {

                            var attrs =
                                attrString.attributesAtIndex_effectiveRange(
                                    index,
                                    rangePointer
                                );

                            if (attrs) {

                                var font =
                                    attrs.objectForKey(
                                        NSFontAttributeName
                                    ) ||
                                    attrs.objectForKey("NSFont");

                                if (font) {

                                    var mixedFont =
                                        String(
                                            font.fontName()
                                        );

                                    if (
                                        fonts.indexOf(
                                            mixedFont
                                        ) === -1
                                    ) {
                                        fonts.push(
                                            mixedFont
                                        );
                                    }
                                }
                            }

                            var range =
                                rangePointer.value();

                            if (!range) {
                                break;
                            }

                            index =
                                range.location +
                                range.length;
                        }
                    }
                }

            } catch (err) {
                log("Attributed Font Error: " + err);
            }

        } catch (err) {
            log(err);
        }

        return fonts;
    }

    //--------------------------------------------------
    // 收集字体
    //--------------------------------------------------

    var textLayers = sketch.find('Text', page);

    var fontMap = [];
    var fontIndex = {};

    textLayers.forEach(function (layer) {

        var fonts =
            getFontsFromTextLayer(layer);

        if (fonts.length === 0) {
            return;
        }

        fontMap.push({
            layer: layer,
            fonts: fonts
        });

        fonts.forEach(function (font) {
            fontIndex[font] = true;
        });

    });

    var allFonts =
        Object.keys(fontIndex).sort();

    if (allFonts.length === 0) {

        UI.message("当前页面未发现字体");

        return;
    }

    //--------------------------------------------------
    // 弹窗
    //--------------------------------------------------

    var alert =
        NSAlert.alloc().init();

    alert.setMessageText(
        "Font Finder"
    );

    alert.setInformativeText(
        "请选择需要查找的字体"
    );

    alert.addButtonWithTitle(
        "选择"
    );

    alert.addButtonWithTitle(
        "取消"
    );

    //--------------------------------------------------
    // 字体列表
    //--------------------------------------------------

    var rowHeight = 26;
    var width = 360;

    var contentHeight =
        allFonts.length * rowHeight;

    var viewHeight =
        Math.min(contentHeight, 240);

    var contentView =
        NSView.alloc().initWithFrame(
            NSMakeRect(
                0,
                0,
                width,
                contentHeight
            )
        );

    // 从顶部开始布局
    contentView.setFlipped(true);

    var checkboxes = [];

    for (
        var i = 0;
        i < allFonts.length;
        i++
    ) {

        var checkbox =
            NSButton.alloc().initWithFrame(
                NSMakeRect(
                    10,
                    i * rowHeight,
                    width - 20,
                    20
                )
            );

        checkbox.setButtonType(
            NSSwitchButton
        );

        checkbox.setTitle(
            allFonts[i]
        );

        checkbox.setState(
            NSControlStateValueOff
        );

        contentView.addSubview(
            checkbox
        );

        checkboxes.push(
            checkbox
        );
    }

    // 字体少时不滚动
    if (contentHeight <= 240) {

        alert.setAccessoryView(
            contentView
        );

    } else {

        var scrollView =
            NSScrollView.alloc().initWithFrame(
                NSMakeRect(
                    0,
                    0,
                    width,
                    viewHeight
                )
            );

        scrollView.setHasVerticalScroller(
            true
        );

        scrollView.setHasHorizontalScroller(
            false
        );

        scrollView.setDocumentView(
            contentView
        );

        alert.setAccessoryView(
            scrollView
        );
    }

    //--------------------------------------------------
    // 显示弹窗
    //--------------------------------------------------

    var response =
        alert.runModal();

    if (
        response !==
        NSAlertFirstButtonReturn
    ) {
        return;
    }

    //--------------------------------------------------
    // 获取用户选择字体
    //--------------------------------------------------

    var selectedFonts = [];

    checkboxes.forEach(function (
        checkbox
    ) {

        if (checkbox.state()) {

            selectedFonts.push(
                String(
                    checkbox.title()
                )
            );
        }

    });

    if (
        selectedFonts.length === 0
    ) {

        UI.message(
            "未选择任何字体"
        );

        return;
    }

    //--------------------------------------------------
    // 清除当前选中
    //--------------------------------------------------

    textLayers.forEach(function (
        layer
    ) {
        layer.selected = false;
    });

    //--------------------------------------------------
    // 匹配图层
    //--------------------------------------------------

    var matchedLayers = [];

    fontMap.forEach(function (
        item
    ) {

        var matched =
            item.fonts.some(function (
                fontName
            ) {

                return (
                    selectedFonts.indexOf(
                        fontName
                    ) !== -1
                );

            });

        if (matched) {

            item.layer.selected =
                true;

            matchedLayers.push(
                item.layer
            );
        }

    });

    //--------------------------------------------------
    // 自动定位
    //--------------------------------------------------

    try {

        if (
            matchedLayers.length > 0 &&
            document.centerOnLayer
        ) {

            document.centerOnLayer(
                matchedLayers[0]
            );

        }

    } catch (e) {}

    //--------------------------------------------------
    // 提示
    //--------------------------------------------------

    UI.message(
        "已选中 " +
        matchedLayers.length +
        " 个文本图层"
    );

};